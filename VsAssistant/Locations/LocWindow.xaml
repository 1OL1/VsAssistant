<Window x:Class="VsAssistant.Locations.LocWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VsAssistant.Locations"
        mc:Ignorable="d"
        Title="Locations"
        Height="200" Width="150" WindowStartupLocation="Manual"
        Background="LightYellow"
        WindowStyle="None" Topmost="True" ShowInTaskbar="False">
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Label Grid.Column="0" Grid.Row="0" Content="Пещера:" HorizontalAlignment="Right" Padding="5 0 5 0" />
        <local:CavePortalLabel Grid.Column="1" Grid.Row="0" TimeToEvent="{Binding TimeToCave}" Padding="0"/>

        <Label Grid.Column="0" Grid.Row="1" Content="Портал:" HorizontalAlignment="Right" Padding="5 0 5 0"/>
        <local:CavePortalLabel Grid.Column="1" Grid.Row="1" TimeToEvent="{Binding TimeToPortal}" Padding="0"/>

        <Label Grid.Column="0" Grid.Row="2" Content="Д.Лес:" HorizontalAlignment="Right" Padding="5 0 5 0"/>
        <local:ResLocLabel Grid.Column="1" Grid.Row="2" Status="{Binding FarForest.Status}" TimeToEvent="{Binding FarForest.TimeToAttack}" Padding="0"/>

        <Label Grid.Column="0" Grid.Row="3" Content="Б.Лес:" HorizontalAlignment="Right" Padding="5 0 5 0"/>
        <local:ResLocLabel Grid.Column="1" Grid.Row="3" Status="{Binding NearForest.Status}" TimeToEvent="{Binding NearForest.TimeToAttack}" Padding="0"/>

        <Label Grid.Column="0" Grid.Row="4" Content="С.Блто:" HorizontalAlignment="Right" Padding="5 0 5 0"/>
        <local:ResLocLabel Grid.Column="1" Grid.Row="4" Status="{Binding NortSwamp.Status}" TimeToEvent="{Binding NortSwamp.TimeToAttack}" Padding="0"/>

        <Label Grid.Column="0" Grid.Row="5" Content="Ю.Блто:" HorizontalAlignment="Right" Padding="5 0 5 0"/>
        <local:ResLocLabel Grid.Column="1" Grid.Row="5" Status="{Binding SoutSwamp.Status}" TimeToEvent="{Binding SoutSwamp.TimeToAttack}" Padding="0"/>

        <Label Grid.Column="0" Grid.Row="6" Content="З.Шахта:" HorizontalAlignment="Right" Padding="5 0 5 0"/>
        <local:ResLocLabel Grid.Column="1" Grid.Row="6" Status="{Binding WestMine.Status}" TimeToEvent="{Binding WestMine.TimeToAttack}" Padding="0"/>

        <Label Grid.Column="0" Grid.Row="7" Content="Б.Шахта:" HorizontalAlignment="Right" Padding="5 0 5 0"/>
        <local:ResLocLabel Grid.Column="1" Grid.Row="7" Status="{Binding NearMine.Status}" TimeToEvent="{Binding NearMine.TimeToAttack}" Padding="0"/>

        <Label Grid.Column="0" Grid.Row="8" Content="Озеро:" HorizontalAlignment="Right" Padding="5 0 5 0"/>
        <local:ResLocLabel Grid.Column="1" Grid.Row="8" Status="{Binding Lake.Status}" TimeToEvent="{Binding Lake.TimeToAttack}" Padding="0"/>

        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" Orientation="Vertical">
            <Button Click="CloseButton_Click">X</Button>
        </StackPanel>
    </Grid>
</Window>
