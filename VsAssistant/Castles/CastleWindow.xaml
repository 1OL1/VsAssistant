<controls:BaseWindow x:Class="VsAssistant.Castles.CastleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VsAssistant.Castles"
        xmlns:controls="clr-namespace:VsAssistant.Controls"
        mc:Ignorable="d"
        Title="🏰 Замки"
        Height="130" Width="190">
    <controls:BaseWindow.Resources>
        <DataTemplate DataType="{x:Type local:CastleViewModel}">
            <Grid Height="22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" SharedSizeGroup="CastleName"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Stripe" Grid.ColumnSpan="4" Background="#148A6428" CornerRadius="2" Visibility="Collapsed"/>

                <TextBlock Grid.Column="0" Text="{Binding Name, StringFormat={}{0}:}" Margin="6 0"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource CaptionBrush}"/>

                <Image Grid.Column="1" Source="{Binding OwnerLogoUrl}" Width="14" Height="14"/>

                <TextBlock x:Name="StatusText" Grid.Column="2" Margin="4 0" Text="{Binding StatusText}"
                           VerticalAlignment="Center" FontFamily="Palatino Linotype, Segoe UI Symbol"
                           Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis"/>

                <Image x:Name="AttackerLogo" Grid.Column="3" Source="{Binding AttackerLogoUrl}" Width="14" Height="14" Margin="0 0 4 0"/>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(ItemsControl.AlternationIndex)}" Value="1">
                    <Setter TargetName="Stripe" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AttackerLogoUrl}" Value="{x:Null}">
                    <Setter TargetName="AttackerLogo" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="AssaultRequested">
                    <Setter TargetName="StatusText" Property="Foreground" Value="#9A3F00"/>
                    <Setter TargetName="StatusText" Property="FontWeight" Value="Bold"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Warning">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="StatusText" Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" AutoReverse="True" Duration="0:0:0.25" RepeatBehavior="5x">
                                    <DoubleAnimation.EasingFunction>
                                        <ElasticEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Warning"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Battle">
                    <Setter TargetName="StatusText" Property="Foreground" Value="Maroon"/>
                    <Setter TargetName="StatusText" Property="FontWeight" Value="Bold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBattleSoon}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard x:Name="Blink">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="StatusText" Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0" AutoReverse="True" Duration="0:0:0.25" RepeatBehavior="Forever">
                                    <DoubleAnimation.EasingFunction>
                                        <ElasticEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Blink"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </controls:BaseWindow.Resources>

    <ItemsControl x:Name="Root" Margin="4 3 4 4" ItemsSource="{Binding Castles}" AlternationCount="2"
                  Grid.IsSharedSizeScope="True" Focusable="False"/>
</controls:BaseWindow>
